{
  "name": "bragfeed.dev",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/purchases/webhook",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:types": "tsc --noEmit",
    "check:build": "next build",
    "check:lint": "eslint --cache --cache-location .next/cache/eslint/",
    "check:format": "prettier --check ./src",
    "check": "pnpm run check:format && pnpm run check:types && pnpm run check:lint && pnpm run test && pnpm run check:build",
    "format": "prettier --write ./src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:clear": "tsx src/scripts/clear-database.ts",
    "db:seed": "tsx src/scripts/seed/seed.ts",
    "db:fresh": "pnpm db:clear && pnpm db:migrate && pnpm db:seed",
    "db:production:migrate": "tsx src/scripts/migrate-production.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "holy-loader": "^2.3.14",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "stripe": "^18.5.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "prismjs": "1.30.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "type": "module"
}
